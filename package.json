{
  "name": "mythwood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "test:audio": "node scripts/audio-check.mjs",
    "test:checkpoints": "npm run build && node scripts/checkpoint-ui-check.mjs",
    "test:ranger": "npm run build && node scripts/ranger-check.mjs",
    "test:caves": "npm run build && node scripts/caves-check.mjs",
    "test:garden": "npm run build && node scripts/garden-check.mjs",
    "test:character": "node scripts/character-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "playwright": "1.62.1",
    "vite": "8.3.7"
  }
}
